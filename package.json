{
  "name": "fiscal-5.0-userscript",
  "version": "5.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:js": "vitest run",
    "test:js:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:stress": "playwright test --repeat-each=5",
    "test:e2e:staging": "node scripts/run-e2e-staging.mjs",
    "test:gate:js": "npm run test:js:coverage && node scripts/check-js-critical-coverage.mjs",
    "test:gate:local": "npm run test:gate:js && npm run test:e2e",
    "test:gate:release": "npm run test:gate:local && npm run test:e2e:staging",
    "test:all": "npm run test:js",
    "coverage:check": "npm run test:gate:js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-monkey": "^4.0.0",
    "vitest": "^3.2.4"
  }
}
